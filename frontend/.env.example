# Frontend Environment Variables Template
# Copy this file to .env or .env.local to override defaults

# Optional: Explicit backend API URL (Leave blank for automatic LAN IP detection)
# VITE_API_BASE_URL=http://192.168.1.5:8000
# For Production Cloud Deployment (e.g. Render backend URL):
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
